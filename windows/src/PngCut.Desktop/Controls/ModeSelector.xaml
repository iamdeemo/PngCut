<UserControl x:Class="PngCut.Desktop.Controls.ModeSelector"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="44"
             AutomationProperties.AutomationId="CompressionModeSelector">
  <Grid Width="176" Height="40">
    <Border Background="#0B000000" CornerRadius="8" />
    <Border x:Name="SelectionPill"
            Width="82"
            Margin="3"
            HorizontalAlignment="Left"
            Background="{StaticResource AccentBrush}"
            CornerRadius="6">
      <Border.RenderTransform>
        <TranslateTransform x:Name="SelectionTransform" />
      </Border.RenderTransform>
    </Border>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Button x:Name="LosslessMode"
              Grid.Column="0"
              MinHeight="44"
              Style="{StaticResource ModeButtonStyle}"
              Content="无损"
              FontWeight="SemiBold"
              AutomationProperties.AutomationId="LosslessMode"
              Click="LosslessMode_OnClick" />
      <Button x:Name="BalancedMode"
              Grid.Column="1"
              MinHeight="44"
              Style="{StaticResource ModeButtonStyle}"
              Content="平衡"
              FontWeight="SemiBold"
              AutomationProperties.AutomationId="BalancedMode"
              Click="BalancedMode_OnClick" />
    </Grid>
  </Grid>
</UserControl>
