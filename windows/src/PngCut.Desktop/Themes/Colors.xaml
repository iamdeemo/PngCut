<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="AccentColor">#2482F1</Color>
  <Color x:Key="WorkspaceColor">#F7F8FA</Color>
  <Color x:Key="DrawerColor">#FFFFFF</Color>
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="WorkspaceBrush" Color="{StaticResource WorkspaceColor}" />
  <SolidColorBrush x:Key="DrawerBrush" Color="{StaticResource DrawerColor}" />
  <SolidColorBrush x:Key="PrimaryTextBrush" Color="#252A31" />
  <SolidColorBrush x:Key="SecondaryTextBrush" Color="#59636F" />
  <SolidColorBrush x:Key="BorderBrush" Color="#D7DCE3" />
  <SolidColorBrush x:Key="FocusBrush" Color="#155DB5" />
</ResourceDictionary>
